# Google Gemini (vision + call classifier)
GEMINI_API_KEY=your-gemini-key-here
# Vision & classifier model. Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs (voice agents + outbound calls)
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_TRIAGE_AGENT_ID=agent_xxx_triage
ELEVENLABS_VET_AGENT_ID=agent_xxx_vet
ELEVENLABS_FOSTER_AGENT_ID=agent_xxx_foster
# Phone number id registered in ElevenLabs (for outbound calls)
ELEVENLABS_PHONE_NUMBER_ID=phnum_xxx

# Google Places (find nearby vets/foster)
GOOGLE_PLACES_API_KEY=your-google-places-key-here

# Demo call redirect — when set, all outbound calls dial this number
# instead of the real clinic phone. Google Places still returns real
# data (names, addresses, ratings) so the UI looks authentic.
# Great for demos — set to your own test number:
DEMO_CALL_PHONE="+94729351901"

# Legacy mock vet — replaces the entire Places search with a single
# fake clinic. Prefer DEMO_CALL_PHONE for demos with real UI data.
# MOCK_VET_PHONE="+94729351901"
# MOCK_VET_NAME=PetCare Veterinary Hospital — Nawala
# MOCK_VET_ADDRESS=47 Nawala Road, Nawala, Sri Lanka

# Database (SQLite) — path to the persistent database file.
# Defaults to pawguard.db in the working directory.
# PAWGUARD_DB_PATH=pawguard.db

# CORS — comma-separated origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Server
PORT=8000
LOG_LEVEL=info
