VITE_API_BASE=http://localhost:8000
VITE_ELEVENLABS_AGENT_ID=agent_xxx_triage

# Location for vet/shelter tools (browser will prompt for GPS unless you use demo mode)
# Set to 1 to skip the permission prompt — uses VITE_DEMO_LAT / VITE_DEMO_LNG (good with MOCK_VET_PHONE on backend).
VITE_USE_DEMO_LOCATION=1
# If GPS fails or page is HTTP (not HTTPS), fall back to demo coords instead of erroring.
VITE_FALLBACK_TO_DEMO_LOCATION=1
# Default demo point (Colombo area). Change for your region.
VITE_DEMO_LAT=6.927079
VITE_DEMO_LNG=79.861243
